#!/data/data/com.termux/files/usr/bin/bash
# Wispr-style: press this widget, speak for a few seconds, and it types the
# transcript into whatever app field is focused (needs ADB + a whisper model).
# Adjust --seconds to taste.
cd "$HOME/local-android-agentic-harness" 2>/dev/null || {
  echo "repo not found at ~/local-android-agentic-harness"; exit 1; }
exec python -m local_agent.voice --type --once --seconds 6
